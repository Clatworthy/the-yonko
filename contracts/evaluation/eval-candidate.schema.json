{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "yonko://contracts/evaluation/eval-candidate",
  "title": "eval-candidate",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "session_id": {
      "type": "string"
    },
    "packet_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "reasons": {
      "type": "array"
    },
    "promoted": {
      "const": false
    }
  },
  "required": [
    "schema_version",
    "session_id",
    "promoted"
  ]
}
