{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "yonko://contracts/evaluation/eval-run",
  "title": "eval-run",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string"
    },
    "case_id": {
      "type": "string"
    },
    "replay_mode": {
      "enum": [
        "frozen_packet",
        "full_pipeline"
      ]
    },
    "packet_hash": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "case_id",
    "replay_mode"
  ]
}
