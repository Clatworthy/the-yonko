{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "yonko-model-selections.schema.json",
  "title": "YonkoModelSelections",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "version", "panels"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "version": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "panels": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/panel" }
    },
    "alternates": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["seat", "panel", "configured", "display_name"],
        "properties": {
          "seat": {
            "type": "string",
            "enum": ["chair", "shanks", "blackbeard", "buggy", "luffy"]
          },
          "panel": { "type": "string", "minLength": 1 },
          "configured": { "type": "string", "minLength": 1 },
          "display_name": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "panel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seats"],
      "properties": {
        "display_name": { "type": "string" },
        "seats": {
          "type": "object",
          "additionalProperties": false,
          "required": ["chair", "shanks", "blackbeard", "buggy", "luffy"],
          "properties": {
            "chair": { "$ref": "#/$defs/seatSelection" },
            "shanks": { "$ref": "#/$defs/seatSelection" },
            "blackbeard": { "$ref": "#/$defs/seatSelection" },
            "buggy": { "$ref": "#/$defs/seatSelection" },
            "luffy": { "$ref": "#/$defs/seatSelection" }
          }
        }
      }
    },
    "seatSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime", "configured", "display_name", "resolve_mode"],
      "properties": {
        "runtime": { "type": "string", "enum": ["cursor", "opencode"] },
        "configured": { "type": "string", "minLength": 1 },
        "resolved": { "type": "string" },
        "display_name": { "type": "string" },
        "provider_hint": { "type": "string" },
        "resolve_mode": {
          "type": "string",
          "enum": ["literal", "exact"]
        },
        "match_substrings": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "activation": {
          "type": "string",
          "enum": ["always_when_routed", "escalation_only"]
        },
        "notes": { "type": "string" }
      }
    }
  }
}
