{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "yonko-verification.schema.json",
  "title": "YonkoVerification",
  "type": "object",
  "additionalProperties": false,
  "required": ["finding_ids", "verdict", "evidence", "verifier"],
  "properties": {
    "finding_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "verdict": {
      "type": "string",
      "enum": ["confirmed", "rejected", "inconclusive"]
    },
    "evidence": { "type": "string", "minLength": 1 },
    "verifier": { "type": "string", "minLength": 1 },
    "notes": { "type": "string" }
  }
}
